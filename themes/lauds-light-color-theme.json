{
  "name": "Lauds",
  "type": "light",
  "colors": {
    "editor.background": "#FFFCF0",
    "editor.foreground": "#101010",
    "editor.selectionBackground": "#F3D2B866",
    "editor.selectionHighlightBackground": "#BFE9DE66",
    "editorLineNumber.foreground": "#A0A1A6",
    "editorLineNumber.activeForeground": "#3F4146",
    "editorCursor.foreground": "#B45A20",
    "editorGroupHeader.tabsBackground": "#F7F3E8",
    "editorWidget.background": "#F7F3E8",
    "editorWidget.border": "#D6D0C4",
    "editorWarning.foreground": "#B45A20",
    "editorError.foreground": "#C1503F",
    "editorInfo.foreground": "#147A65",
    "editorOverviewRuler.border": "#D6D0C4",
    "editorGutter.addedBackground": "#147A65",
    "editorGutter.deletedBackground": "#C1503F",
    "editorGutter.modifiedBackground": "#B45A20",
    "diffEditor.insertedTextBackground": "#BFE9DE66",
    "diffEditor.insertedLineBackground": "#BFE9DE33",
    "diffEditor.removedTextBackground": "#F6C8BF66",
    "diffEditor.removedLineBackground": "#F6C8BF33",
    "editorInlayHint.foreground": "#5F6166",
    "editorInlayHint.background": "#F7F3E8",
    "sideBar.background": "#F7F3E8",
    "sideBar.foreground": "#101010",
    "sideBarTitle.foreground": "#5F6166",
    "sideBarSectionHeader.foreground": "#5F6166",
    "sideBarSectionHeader.background": "#EDE8DC",
    "activityBar.background": "#F7F3E8",
    "activityBar.foreground": "#3F4146",
    "activityBar.inactiveForeground": "#6E7075",
    "activityBarBadge.background": "#B45A20",
    "activityBarBadge.foreground": "#FFFCF0",
    "titleBar.activeBackground": "#F7F3E8",
    "titleBar.inactiveBackground": "#F7F3E8",
    "titleBar.activeForeground": "#3F4146",
    "titleBar.inactiveForeground": "#6E7075",
    "tab.border": "#D6D0C4",
    "tab.activeBackground": "#FFFCF0",
    "tab.activeForeground": "#101010",
    "tab.activeBorder": "#B45A20",
    "tab.inactiveBackground": "#F7F3E8",
    "tab.inactiveForeground": "#5F6166",
    "panel.background": "#FFFCF0",
    "panel.border": "#D6D0C4",
    "panelTitle.activeForeground": "#B45A20",
    "panelTitle.inactiveForeground": "#5F6166",
    "statusBar.background": "#F7F3E8",
    "statusBar.noFolderBackground": "#F7F3E8",
    "statusBar.foreground": "#5F6166",
    "statusBar.border": "#D6D0C4",
    "statusBar.debuggingForeground": "#FFFCF0",
    "statusBar.debuggingBackground": "#B45A20",
    "statusBarItem.remoteBackground": "#B45A20",
    "statusBarItem.remoteForeground": "#FFFCF0",
    "list.activeSelectionForeground": "#B45A20",
    "list.activeSelectionBackground": "#EDE8DC",
    "list.inactiveSelectionBackground": "#EDE8DC",
    "list.hoverBackground": "#EDE8DC",
    "list.errorForeground": "#C1503F",
    "list.highlightForeground": "#B45A20",
    "badge.background": "#B45A20",
    "badge.foreground": "#FFFCF0",
    "button.background": "#B45A20",
    "button.hoverBackground": "#934414",
    "button.foreground": "#FFFCF0",
    "focusBorder": "#B45A20",
    "icon.foreground": "#5F6166",
    "input.background": "#F7F3E8",
    "input.foreground": "#101010",
    "input.border": "#D6D0C4",
    "selection.background": "#F3D2B866",
    "editorBracketHighlight.foreground1": "#5F6166",
    "editorBracketHighlight.foreground2": "#5F6166",
    "editorBracketHighlight.foreground3": "#5F6166",
    "editorBracketHighlight.foreground4": "#5F6166",
    "editorBracketHighlight.foreground5": "#5F6166",
    "editorBracketHighlight.foreground6": "#5F6166",
    "editorBracketHighlight.unexpectedBracket.foreground": "#C1503F",
    "textLink.foreground": "#B45A20",
    "textLink.activeForeground": "#934414",
    "editorHoverWidget.background": "#F7F3E8",
    "editorHoverWidget.border": "#D6D0C4",
    "scrollbarSlider.background": "#D6D0C480",
    "scrollbarSlider.hoverBackground": "#B8B4AD",
    "settings.modifiedItemIndicator": "#B45A20",
    "terminal.ansiBlack": "#101010",
    "terminal.ansiRed": "#C1503F",
    "terminal.ansiGreen": "#147A65",
    "terminal.ansiYellow": "#B45A20",
    "terminal.ansiBlue": "#7264A8",
    "terminal.ansiMagenta": "#B34A72",
    "terminal.ansiCyan": "#147A65",
    "terminal.ansiWhite": "#F7F3E8",
    "terminal.ansiBrightBlack": "#5F6166",
    "terminal.ansiBrightRed": "#C1503F",
    "terminal.ansiBrightGreen": "#147A65",
    "terminal.ansiBrightYellow": "#B45A20",
    "terminal.ansiBrightBlue": "#7264A8",
    "terminal.ansiBrightMagenta": "#B34A72",
    "terminal.ansiBrightCyan": "#147A65",
    "terminal.ansiBrightWhite": "#FFFCF0"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#6E7075"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder", "entity.name.tag"],
      "settings": {
        "foreground": "#101010"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#C1503F"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#5F6166"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.control", "keyword.operator", "punctuation", "punctuation.definition.tag", "punctuation.section.embedded"],
      "settings": {
        "foreground": "#5F6166"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.deleted.git_gutter"],
      "settings": {
        "foreground": "#B45A20"
      }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "variable.function", "support.function", "keyword.other.special-method"],
      "settings": {
        "foreground": "#B45A20"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "support.constant", "constant.character", "constant.escape", "keyword.other.unit", "keyword.other", "constant.language.boolean"],
      "settings": {
        "foreground": "#B45A20"
      }
    },
    {
      "name": "String",
      "scope": ["string", "constant.other.symbol", "constant.other.key"],
      "settings": {
        "foreground": "#147A65"
      }
    },
    {
      "name": "Class",
      "scope": ["entity.name", "support.type", "support.class", "support.other.namespace", "markup.changed.git_gutter", "support.type.sys-types"],
      "settings": {
        "foreground": "#B45A20"
      }
    },
    {
      "name": "CSS Property",
      "scope": ["source.css support.type.property-name", "source.scss support.type.property-name", "source.less support.type.property-name", "meta.property-name.css"],
      "settings": {
        "foreground": "#101010"
      }
    },
    {
      "name": "Language Variable",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#5F6166"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name", "meta.property-list.scss", "meta.attribute-selector.scss", "meta.selector.css"],
      "settings": {
        "foreground": "#B45A20"
      }
    },
    {
      "name": "Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#147A65"
      }
    },
    {
      "name": "Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#C1503F"
      }
    },
    {
      "name": "Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#5F6166"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#5F6166"
      }
    },
    {
      "name": "URL",
      "scope": ["*url*", "*link*", "*uri*"],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "JSON Key",
      "scope": ["source.json meta.structure.dictionary.json support.type.property-name.json"],
      "settings": {
        "foreground": "#B45A20"
      }
    },
    {
      "name": "Markdown Plain",
      "scope": ["text.html.markdown", "punctuation.definition.list_item.markdown"],
      "settings": {
        "foreground": "#101010"
      }
    },
    {
      "name": "Markdown Raw Inline",
      "scope": ["text.html.markdown markup.inline.raw.markdown"],
      "settings": {
        "foreground": "#5F6166"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markdown.heading", "markup.heading", "markup.heading.markdown punctuation.definition.heading.markdown"],
      "settings": {
        "foreground": "#B45A20"
      }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#101010"
      }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold", "markup.bold string"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#101010"
      }
    },
    {
      "name": "Markup Underline",
      "scope": ["markup.underline"],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#B45A20"
      }
    },
    {
      "name": "Markdown Link Description",
      "scope": ["string.other.link.description.title.markdown"],
      "settings": {
        "foreground": "#5F6166"
      }
    },
    {
      "name": "Markdown Link Anchor",
      "scope": ["constant.other.reference.link.markdown"],
      "settings": {
        "foreground": "#B45A20"
      }
    },
    {
      "name": "Markup Raw Block",
      "scope": ["markup.raw.block"],
      "settings": {
        "foreground": "#5F6166"
      }
    },
    {
      "name": "Markup Table",
      "scope": ["markup.table"],
      "settings": {
        "foreground": "#101010"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#B45A20",
    "method": "#B45A20",
    "string": "#147A65",
    "number": "#B45A20",
    "comment": {
      "foreground": "#6E7075",
      "italic": true
    },
    "keyword": "#5F6166",
    "variable": "#101010",
    "property": "#101010",
    "type": "#B45A20"
  }
}
